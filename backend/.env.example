# Copy to backend/.env (git-ignored) and fill in. Read by Spring Boot at startup
# (spring.config.import in application.yml). Real environment variables win over this file.

# --- database (local PostgreSQL 16) ---
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=ecom_app
DB_PASSWORD=change-me

# --- tokens ---
# base64 key, at least 32 bytes:  openssl rand -base64 48
JWT_SECRET=
# the dev server is plain http://localhost, so the refresh cookie can't be Secure locally
COOKIE_SECURE=false

# --- "Continue with Google" (optional): create an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:5173/login/oauth2/code/google (and :8080 if you use that port)
# spring.security.oauth2.client.registration.google.client-id=
# spring.security.oauth2.client.registration.google.client-secret=

# --- demo catalogue on an empty database ---
DEMO_DATA=true
DEMO_SELLER_EMAIL=seller@demo.local
DEMO_SELLER_PASSWORD=change-me-too

# --- order confirmation e-mails (optional) ---
MAIL_ENABLED=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
