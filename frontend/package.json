{
  "name": "ecommerce-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Clothing store frontend: plain HTML + CSS + TypeScript (native ES modules, no framework)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
